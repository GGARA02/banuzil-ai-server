# ── 필수 ──────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key-here

# ── 모델 ──────────────────────────────────────
MODEL_NAME=gpt-5.4
EVAL_MODEL_NAME=gpt-4o-mini
TEMPERATURE=0.7

# ── 토큰 제한 ─────────────────────────────────
MAX_OUTPUT_TOKENS=800
REPORT_MAX_TOKENS=3000

# ── 상담 동작 ─────────────────────────────────
MBTI_WEIGHT=0.2
ATTACHMENT_PROMPT_WEIGHT=1.0
EMOTION_WEIGHT=0.3
BULLET_DETECTION_ENABLED=true
BULLET_THRESHOLD=0.6
MAX_REFINE=3
MIN_STAGE_ROUNDS=2

# ── 품질 기준 ─────────────────────────────────
EVAL_PASS_SCORE=3.5
SAFETY_GATE_SCORE=3.0

# ── Supabase ──────────────────────────────────
SUPABASE_URL=https://btuopynrwnqkktxsqjys.supabase.co
SUPABASE_KEY=your-supabase-secret-key-here